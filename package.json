{
  "name": "portfolio-frontend-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise-grade Micro-Frontend Portfolio Monorepo with AI RAG Assistant",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:e2e": "turbo run test:e2e",
    "smoke:production": "node scripts/smoke-deployment.mjs",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules packages/*/node_modules apps/*/node_modules .turbo"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "prettier": "^3.4.2"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": "5.0.8",
      "postcss": "8.5.24",
      "sharp": "0.35.3"
    }
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0"
  }
}
